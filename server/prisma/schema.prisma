generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TripStatus {
  DRAFT
  PLANNED
  COMPLETED
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  ACTIVITIES
  MEALS
  OTHER
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  password         String
  city             String?
  country          String?
  phone            String?
  bio              String?
  profilePic       String?
  role             Role               @default(USER)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  trips            Trip[]
  savedDestinations SavedDestination[]
  communityLikes   CommunityLike[]
  communityPosts   CommunityPost[]

  @@index([email])
}

model Trip {
  id             String          @id @default(uuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  coverImage     String?
  startDate      DateTime?
  endDate        DateTime?
  totalBudget    Float           @default(0)
  status         TripStatus      @default(PLANNED)
  isPublic       Boolean         @default(false)
  shareId        String          @unique @default(uuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stops          TripStop[]
  itineraryItems ItineraryItem[]
  expenses       Expense[]
  communityLikes CommunityLike[]
  communityPosts CommunityPost[]

  @@index([userId])
  @@index([shareId])
  @@index([isPublic])
}

model TripStop {
  id             String          @id @default(uuid())
  tripId         String
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city           String
  country        String
  arrivalDate    DateTime?
  departureDate  DateTime?
  order          Int             @default(0)
  notes          String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  itineraryItems ItineraryItem[]

  @@index([tripId])
}

model ItineraryItem {
  id          String          @id @default(uuid())
  tripId      String
  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripStopId  String?
  tripStop    TripStop?       @relation(fields: [tripStopId], references: [id], onDelete: SetNull)
  dayNumber   Int             @default(1)
  date        DateTime?
  time        String?
  title       String
  description String?
  category    ExpenseCategory @default(ACTIVITIES)
  expense     Float           @default(0)
  location    String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tripId])
  @@index([tripStopId])
}

model Expense {
  id          String          @id @default(uuid())
  tripId      String
  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Float
  currency    String          @default("USD")
  description String
  date        DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tripId])
}

model SavedDestination {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cityName    String
  countryName String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model CommunityPost {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tripId])
}

model CommunityLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, tripId])
  @@index([tripId])
}
